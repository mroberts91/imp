#!/sbin/openrc-run
# imp - declarative single-host process orchestrator (OpenRC service)
#
# OpenRC has no DynamicUser equivalent, so the 'imp' system user and the
# persistent directories are created by install.sh. This script only supplies
# the runtime (tmpfs) socket directory and the supervision policy.
#
# Cgroup note: systemd installs get Delegate=yes; OpenRC does not. For real
# memory/cpu/pids limits and D1 re-attach, prepare a writable cgroup v2
# subtree and set IMP_CGROUP_ROOT (see docs/install.md). Without it, impd
# will fail to start unless --cgroup-root is passed some other way.
#
# impd is configured by flags only (it reads no environment variables); the
# IMP_* variables below exist so /etc/conf.d/imp can override the flag values
# and the log destination in one place.

name="imp"
description="Declarative single-host process orchestrator"

# --- Configuration (override in /etc/conf.d/imp) --------------------------
: "${IMP_USER:=imp}"
: "${IMP_GROUP:=imp}"
: "${IMP_BIN_DIR:=/usr/local/bin}"
: "${IMP_DATA_DIR:=/var/lib/imp}"
: "${IMP_MANIFEST_DIR:=/etc/imp/manifests}"
: "${IMP_RUN_DIR:=/run/imp}"
: "${IMP_SOCKET:=${IMP_RUN_DIR}/impd.sock}"
: "${IMP_LOG_FILE:=/var/log/imp/impd.log}"
# Optional: writable cgroup v2 path (e.g. /sys/fs/cgroup/imp). Required for
# OpenRC unless auto-detect finds a usable self cgroup (unusual without systemd).
: "${IMP_CGROUP_ROOT:=}"

command="${IMP_BIN_DIR}/impd"
command_args="--socket ${IMP_SOCKET} --data-dir ${IMP_DATA_DIR} --manifest-dir ${IMP_MANIFEST_DIR}"
if [ -n "${IMP_CGROUP_ROOT}" ]; then
    command_args="${command_args} --cgroup-root ${IMP_CGROUP_ROOT}"
fi

# Drop privileges to the unprivileged service user (single-user model).
command_user="${IMP_USER}:${IMP_GROUP}"

# Supervise impd with supervise-daemon so a crash respawns it. impd's panic
# policy is crash-only (doc 05 §3): unexpected panics kill the process on
# purpose and rely on the supervisor to restart it. Mirrors systemd's
# Restart=on-failure + RestartSec=2s; give up after 5 respawns in 60s so a
# broken config doesn't spin forever. supervise-daemon manages its own
# pidfile and backgrounding - no command_background/pidfile here.
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=5
respawn_period=60

# impd logs JSON to stderr; under systemd journald would catch it, here we
# redirect it to a file. (No rotation is set up - pair with logrotate if the
# host runs long.)
output_log="${IMP_LOG_FILE}"
error_log="${IMP_LOG_FILE}"

# Shutdown policy: signal only impd and give it up to 90s. Default impd leaves
# children alive for D1 re-attach (like systemd KillMode=process). For full
# tear-down, add --kill-procs-on-shutdown to command_args or delete via impctl.
retry="SIGTERM/90"

depend() {
    need localmount
    use logger
    after net
}

start_pre() {
    # /run is tmpfs: recreate the socket directory each boot, owned by the
    # service user, mode 0750. checkpath is OpenRC's idempotent equivalent of
    # systemd's RuntimeDirectory=.
    checkpath --directory --mode 0750 \
        --owner "${IMP_USER}:${IMP_GROUP}" "${IMP_RUN_DIR}"
    # The log file must be writable by the service user before supervise-daemon
    # redirects into it.
    checkpath --file --mode 0640 \
        --owner "${IMP_USER}:${IMP_GROUP}" "${IMP_LOG_FILE}"
}

# --- Multi-user supervision hook (DISABLED: single-user build) -------------
# OpenRC cannot grant ambient capabilities the way systemd does. To run Procs
# as OTHER users later you must either:
#   * run impd as root and let it drop to each Proc's user itself (remove
#     command_user above), or
#   * grant file capabilities on the binary:
#       setcap cap_setuid,cap_setgid+ep /usr/local/bin/impd
#     (re-applied on every upgrade, since replacing the binary clears caps).
